{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.earthcoop.ir/schemas/knowledge-document.schema.json",
  "title": "EarthCoop multilingual knowledge center manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "canonicalDefaultLanguage", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "canonicalDefaultLanguage": { "enum": ["fa", "en", "ar"] },
    "registryRole": { "type": "string" },
    "statusSemantics": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documentId", "slug", "contentClass", "canonicalLanguage", "legalStatus", "authority", "version", "reviewedAt", "renditions"],
        "properties": {
          "documentId": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
          "slug": { "type": "string", "pattern": "^[a-z0-9/-]+$" },
          "contentClass": { "enum": ["guide", "foundational_document", "policy", "reference", "technical"] },
          "canonicalLanguage": { "enum": ["fa", "en", "ar"] },
          "legalStatus": { "enum": ["concept", "unofficial_explanation", "under_audit", "official_draft", "public_consultation", "registered_not_effective", "approved_not_effective", "effective", "superseded", "withdrawn"] },
          "productStatus": {
            "anyOf": [
              { "enum": ["available", "in_development", "planned"] },
              { "type": "null" }
            ]
          },
          "authority": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "reviewedAt": { "type": "string", "format": "date" },
          "renditions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fa", "en", "ar"],
            "properties": {
              "fa": { "$ref": "#/$defs/rendition" },
              "en": { "$ref": "#/$defs/rendition" },
              "ar": { "$ref": "#/$defs/rendition" }
            }
          },
          "provisions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "anchor"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
                "anchor": { "type": "string", "pattern": "^[a-z0-9-]+$" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "rendition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "status", "sourceVersion"],
      "properties": {
        "source": { "type": ["string", "null"] },
        "status": { "enum": ["current", "needs_review", "outdated", "not_translated"] },
        "sourceVersion": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "not_translated" } }, "required": ["status"] },
          "then": {
            "properties": {
              "source": { "type": "null" },
              "sourceVersion": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "source": { "type": "string", "minLength": 1, "pattern": "^[^/].*\\.mdx?$" },
              "sourceVersion": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
