{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.earthcoop.ir/schemas/terminology.schema.json",
  "title": "EarthCoop canonical multilingual terminology",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "terms"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "fa", "en", "ar"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "fa": { "type": "string", "minLength": 1 },
          "en": { "type": "string", "minLength": 1 },
          "ar": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
